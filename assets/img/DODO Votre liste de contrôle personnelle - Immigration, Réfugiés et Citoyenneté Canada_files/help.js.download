{
	closeAllHelp( );
	var glossaryDocumentId = "trGlossaryDisplay" + glossaryId;
	
	var showHelp   = false;
	
	// are we opening or closing this glossary item
	if( document.getElementById( glossaryDocumentId ).style.display == "" )
	{
		showHelp = false;
	}
	else
	{
		showHelp = true;
	}
	// close any glossary blocks currently open
	closeAllGlossaryItems( );
	
	// if we are opening, then show the chosen one.
	if( showHelp == true )
	{
		document.getElementById(glossaryDocumentId).style.display = "";
		//incrementGlossaryCount();
		incrementGlossaryItemCount( glossaryId );
		//window.location = "#start_glossary";
		window.location = "#"+glossaryDocumentId;
	}	
}


function displayDocumentHelp( documentTypeCode, helpTextKeyArray, language )
{
	if( language == null )
	{
		language = "en";
	}
	
	var idPostFix = "English";
	if( language == "fr" )
	{
		idPostFix = "French";
	}
	
	var documentElementId = "trHelpDisplay" + idPostFix + documentTypeCode;
	
	var showHelp = false;
	
	// are we opening or closing this help item
	if( document.getElementById( documentElementId ).style.display == "" )
	{
		showHelp = false;
	}
	else
	{
		showHelp = true;
	}

	// close any help blocks currently open
	closeAllDocuments( helpTextKeyArray );
	
	// if we are opening, then show the chosen one.
	if( showHelp == true )
	{
		document.getElementById(documentElementId).style.display = "";

		incrementHelpCount();
		
		window.location = "#start_help";
	}	
}

function closeAllDocuments( helpTextKeyArray )
{
	if ( helpTextKeyArray.length > 0 )
	{
		// loop through the possible list of help blocks and close them all (French and English!)
		var arrayLength = helpTextKeyArray.length;
		for ( var i =0; i < arrayLength; i++ )
		{	
			if(document.getElementById("trHelpDisplayEnglish" + helpTextKeyArray[i]) != null)
				document.getElementById("trHelpDisplayEnglish" + helpTextKeyArray[i]).style.display = "none";
			
			if(document.getElementById("trHelpDisplayFrench" + helpTextKeyArray[i]))
				document.getElementById("trHelpDisplayFrench" + helpTextKeyArray[i]).style.display = "none";
		}
	}	
}

function incrementHelpCount()
{
	// Behaviour change - we only want to record that they hit it once, so the count is never set to > 1

	// increment the help count
	var helpCount = document.getElementById("helpCount");
	if( helpCount != null ) 
	{
		var helpCountValue 	 = parseInt( helpCount.value);
		//var newHelpCount 	 = helpCountValue+1;
		newHelpCount=1;
		
		helpCount.value = newHelpCount;
	}
}

function incrementGlossaryItemCount( glossaryItem )
{
	// Behaviour change - we only want to record that they hit it once, so the count is never set to > 1
	var glossaryCountId = "glossaryCounter" + glossaryItem;

	// increment the glossary count
	var glossaryCount = document.getElementById( glossaryCountId );
    if( glossaryCount != null ) 
    {
		var glossaryCountValue 	 = parseInt( glossaryCount.value);
		//var newGlossaryCount 	 = glossaryCountValue+1;
		var newGlossaryCount 	 = 1;
	
		glossaryCount.value = newGlossaryCount;
    }
}

function closeAllGlossaryItems(  )
{
	var glossaryIDList = document.getElementById("glossaryIDList").value;
	
	if ( glossaryIDList != null && glossaryIDList != "" )
	{
		var glossaryArray = glossaryIDList.split(",");
	
		if ( glossaryArray != null )
		{

			// loop through the possible list of help blocks and close them all
			var arrayLength = glossaryArray.length;
			for ( var i =0; i < arrayLength; i++ )
			{	
				document.getElementById("trGlossaryDisplay" + glossaryArray[i]).style.display = "none";
			}
		}
	}	
}


function closeAllHelp( )
{
	document.getElementById("trHelpDisplayFrench" ).style.display = "none";
	document.getElementById("trHelpDisplayEnglish" ).style.display = "none";
	
	if(document.getElementById("helpImage") != null)
		document.getElementById("helpImage").style.display = "";
	
	if(document.getElementById("helpImageRed") != null)
		document.getElementById("helpImageRed").style.display = "none";		
}

function closeAllHelp2(divId, lang)
{
	document.getElementById(divId + lang).style.display = "none";
	document.getElementById(divId +"B").style.display = "";
	document.getElementById(divId +"R").style.display = "none";
}

function displayHelp( )
{
	closeAllGlossaryItems( );
	
	var helpLang = document.getElementById("helpLang").value;

	if( helpLang == "fr" )
	{
		toggleHelp( "trHelpDisplayFrench" );
	}
	else
	{
		toggleHelp( "trHelpDisplayEnglish" );
	}
}

function displayHelp2(divId)
{
	closeAllGlossaryItems( );
	
	var helpLang = document.getElementById("helpLang").value;

	if( helpLang == "fr" )
	{
		toggleHelp2(divId,'-f');
	}
	else
	{
		toggleHelp2(divId, '-e');
	}
}

function toggleHelp( languageHelpElementId )
{
	if( document.getElementById(languageHelpElementId).style.display == "" )
	{
		document.getElementById(languageHelpElementId).style.display = "none";
		document.getElementById("helpImage").style.display = "";
		document.getElementById("helpImageRed").style.display = "none";		
	}
	else
	{
		document.getElementById(languageHelpElementId).style.display = "";
		document.getElementById("helpImage").style.display = "none";
		document.getElementById("helpImageRed").style.display = "";			
		incrementHelpCount();
		
		window.location = "#start_help";
	}
}

function toggleHelp2( languageHelpElementId, lang )
{
	if( document.getElementById(languageHelpElementId + lang).style.display == "" )
	{
		document.getElementById(languageHelpElementId + lang).style.display = "none";
		document.getElementById(languageHelpElementId+"B").style.display = "";
		document.getElementById(languageHelpElementId+"R").style.display = "none";				
	}
	else
	{		
		document.getElementById(languageHelpElementId + lang).style.display = "";
		document.getElementById(languageHelpElementId+"B").style.display = "none";
		document.getElementById(languageHelpElementId+"R").style.display = "";				
		incrementHelpCount();
	}
}

function changeHelpLanguage( )
{
 	var helpLang = document.getElementById("helpLang").value;
 
 	if( helpLang == "fr" )
 	{
 		document.getElementById("helpLang").value = "en";
 	}
 	else
 	{
 		document.getElementById("helpLang").value = "fr";
 	}
 	
 	closeAllHelp( );
 	displayHelp( );
}

function changeHelpLanguage2(divId)
{
 	var helpLang = document.getElementById("helpLang").value;
 
 	if( helpLang == "fr" )
 	{
 		document.getElementById("helpLang").value = "en";
 	 	closeAllHelp2(divId, '-f');
 	}
 	else
 	{
 		document.getElementById("helpLang").value = "fr";
 	 	closeAllHelp2(divId, '-e');
 	} 	

 	displayHelp2(divId);
}





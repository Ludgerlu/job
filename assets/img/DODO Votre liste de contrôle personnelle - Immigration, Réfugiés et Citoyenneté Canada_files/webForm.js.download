function showOverlay() {
	// add the overlay with loading image to the page
	
	var over = '<div id="overlay">'
			+ '<img id="loading" src="/eapp/resource/wet-boew/assets/loading.png" alt="Loading">'
			+ '</div>';
	$(over).appendTo("#body");
}

function hideOverlay() {
	var overlay = eapp.webforms.overlay;
	if (overlay.timeoutId) {
		clearTimeout(overlay.timeoutId);
	}

	overlay.timeoutId = undefined;
	overlay.showTime = undefined;

	// console.log("showOverlay: removing overlay.");

	$("#overlay").remove();
}

function modifyActivity(evtObj, uniqueIndex, rowData) {
	var gridId = getGridId(evtObj);
	var rowIndex = getGridRowIndex(gridId, uniqueIndex);
	setGridRowSelection(gridId, rowIndex, true);

	var cell = getGridRowCell(gridId, uniqueIndex);
	var divId = cell.value;

	// update which template to load and which div to update
	setNextAction(divId + "_modify");

	// get all data for submission, we will update it with the object to be
	// modified below
	var dataObj = getData();

	var readOnlyMode = eapp.webforms.display.readOnlyMode;
	var jsonData = JSON.stringify(dataObj);

	$
			.ajax({
				url : "/eapp/showNext",
				data : jsonData,
				type : "POST",
				dataType : "json",

				beforeSend : function(xhr) {
					xhr.setRequestHeader("Accept", "application/json");
					xhr.setRequestHeader("Content-Type", "application/json");
				},
				// code to run if the request succeeds;
				// the response is passed to the function
				success : function(responseObject) {
					removeFixedErrors(responseObject.errors);
					// enable all panels
					enable();
					var errorsFlags = {};

					// do not overwrite html with empty string if there was
					// validation error on the server side
					if (responseObject.html !== null && responseObject.html !== "") {
						getElement("#" + divId).html(responseObject.html);
						if (responseObject.errors !== null) {
							errorsFlags = addErrors(divId,
							responseObject.errors, false);
						}
						if (readOnlyMode) {
							var divControls = getAllFormControls(divId);
							makeDivContentReadOnly(divControls, divId);
						}
					}

					// call up any init' method if we have one available.
					if ((typeof onModifyActionComplete !== "undefined") && jQuery.isFunction(onModifyActionComplete)) {
						onModifyActionComplete(gridId, responseObject.webForm);
					}
					updateGrid(gridId);
                }

        });
}
function makeDivContentReadOnly(divControls, divId) {
	if (eapp.webforms.display.readOnlyMode) {
		var allButtons = getAllButtons(divId);
		var allControls = $.merge(divControls, allButtons);
		addReadOnlyAttribute(allControls);
	}
}
function disableSaveAndExit() {
	// disable saveAndExit button till all errors are fixed
	var $saveAndExitButton = $("#saveAndExitBtn");
	if ($saveAndExitButton) {
		$saveAndExitButton.attr("disabled", true);
	}
	$saveAndExitButton = $("#saveAndExitBtn2");
	if ($saveAndExitButton) {
		$saveAndExitButton.attr("disabled", true);
	}
}

function enableSaveAndExit() {
	// disable saveAndExit button till all errors are fixed
	var $saveAndExitButton = $("#saveAndExitBtn");
	if ($saveAndExitButton) {
		$saveAndExitButton.attr("disabled", false);
	}
	$saveAndExitButton = $("#saveAndExitBtn2");
	if ($saveAndExitButton) {
		$saveAndExitButton.attr("disabled", false);
	}
}

function getGridId(eventObj) {
	if (eventObj && eventObj.data && eventObj.data.tbWhole) {
		return eventObj.data.tbWhole.id;
	}
}

function getGridRowCell(gridId, uniqueIndex) {
	return $("#" + gridId).appendGrid('getCellCtrlByUniqueIndex', 'divCol',
			uniqueIndex);
}

function getGridRowIndex(gridId, uniqueIndex) {
	return $("#" + gridId).appendGrid('getRowIndex', uniqueIndex);
}

function getGridRowCount(gridId) {
	return getElement(gridId).appendGrid('getRowCount');
}

function setGridRowSelection(gridId, rowIndex, isSelected) {
	// re-set all selected to false to avoid having more than 1 row with
	// selected = true
	var grid = $("#" + gridId);
	if (grid) {
		var numberOfRows = grid.appendGrid('getRowCount');
		for (var i = 0; i < numberOfRows; i++) {
			grid.appendGrid('setCtrlValue', 'selected', i, false);
		}

		if (isSelected && isSelected === true)
			grid.appendGrid('setCtrlValue', 'selected', rowIndex, isSelected);

		scrollToElement(grid);
	}
}

/**
 * This function is used to scroll up the window up to selected element or
 * section assumption: this function is applicable for only three parent exist
 * case section, Table, selected element
 */
function scrollToElement(grid) {

	return $('html, body').animate({
		scrollTop : grid.parent().parent().parent().offset().top
	}, 1000);

}

function getWebFormDate(dateString, isFuzzy) {
	var webFormDate = {};
	var selectedYear = {};
	var constants = eapp.webforms.constants;
	var dateSeparator = constants.dateSeparator;
	dateString = dateString.replace(/-/gi, dateSeparator);
	var dateArr = dateString.split(dateSeparator);
	if (dateArr.length < (isFuzzy ? 2 : 3) || dateArr[0] == "undefined"
			|| dateArr[1] == "undefined"
			|| (!isFuzzy && dateArr[2] == "undefined"))
		return null;

	// removed new Date() function, since it was not creating correct dates
	selectedYear = new Lov(dateArr[0], true);
	webFormDate.year = selectedYear;

	var value = dateArr[1];
	if (value == constants.dateUnknownDisplay) {
		value = constants.dateUnknown;
	}
	var selectedMonth = new Lov(value, true);
	webFormDate.month = selectedMonth;

	if (!isFuzzy) {
		value = dateArr[2];
		if (value == constants.dateUnknownDisplay) {
			value = constants.dateUnknown;
		}
		var selectedDay = new Lov(value, true);
		webFormDate.day = selectedDay;
	}

	return webFormDate;
}
function getWebFormDateAsString(webFormDate, isFuzzy) {
	if (webFormDate) {

		if (webFormDate.year && webFormDate.month && webFormDate.day
				&& webFormDate.year.lovId != -1
				&& webFormDate.month.lovId != -1
				&& (isFuzzy || (!isFuzzy && webFormDate.day.lovId != -1))) {

			return eapp.webforms.formatDate(webFormDate.year.lovId,
					webFormDate.month.lovId, webFormDate.day.lovId, isFuzzy);
		} else {
			if (webFormDate.year && webFormDate.year.lovId != -1) {
				var year = webFormDate.year.lovId;

				if (webFormDate.month && webFormDate.month.lovId != -1)
					month = webFormDate.month.lovId;

				var day = null;

				if (!isFuzzy && webFormDate.day && webFormDate.day.lovId != -1)
					day = webFormDate.day.lovId;

				return eapp.webforms.formatDate(year, month, day, isFuzzy);
			}
		}
	} else {
		return null;
	}
}

function getSelectedValue(elementId, notSelectedValue) {
	selectedElement = getElement('#' + elementId + ' :selected');
	return (selectedElement ? (selectedElement.val() == notSelectedValue ? ""
			: selectedElement.val()) : "");
}

function appendRow(gridId, divId) {
	var fullGridId = '#tblAppendGrid_' + gridId;
	var controls = getAllFormControls(divId);
	var columns = [];
	var gridEl = getElement(fullGridId);
	var numberOfRows = gridEl.appendGrid('getRowCount');
	var lastRowIndex = numberOfRows - 1;
	if (lastRowIndex == -1) {
		lastRowIndex = 0;
	}

	var modify = false;
	for (var index = 0; index < numberOfRows; index++) {
		var selected = gridEl.appendGrid('getCtrlValue', 'selected', index);
		if (selected == "true") {
			lastRowIndex = index;
			modify = true;
			gridEl.appendGrid('setCtrlValue', 'selected', index, false);
		}
	}

	// if modifying grid data, make sure to reset all the previous values. This
	// is done to eliminate the case where old data is persisted for a field
	// that is no longer on screen as a result of modifying a field that
	// triggered its presence
	if (modify) {
		var columnsNames = gridEl.find("td.ui-widget-content");
		columnsNames.each(function() {
			if (this.id) {
				var columnName = this.id.split("_td_")[0];
				var columnId = columnName.split("_")[1];
				var cellCtrl = gridEl.appendGrid('getCellCtrl', columnId,
						lastRowIndex);
				if (cellCtrl !== null) {
					cellCtrl.setAttribute("data-lovid", -1);
					cellCtrl.value = "";
				}

			}
		});
	}

	for (index = 0; index < controls.length; index++) {
		var col = {};
		var control = controls[index];
		var properties = control.id.split("-");
		var propertyName = properties[properties.length - 1];

		if (propertyName == 'year' && control.type == "select-one") {
			var isFuzzyDate = $(control).hasClass("fuzzy-date");
			var dateObjName = properties[0];

			var monthName = dateObjName + "-month";
			var dayName = dateObjName + "-day";

			var monthSelect = getElement('[id="' + monthName + '"]')[0];
			var daySelect = (!isFuzzyDate) ? getElement('[id="' + dayName
					+ '"]')[0] : null;

			var yearValue = getSelectedValue(control.id, "year_not_selected");
			var monthValue = getSelectedValue(monthSelect.id,
					"month_not_selected");
			var dayValue = (!isFuzzyDate) ? getSelectedValue(daySelect.id,
					"day_not_selected") : null;
			var fullDate = eapp.webforms.formatDate(yearValue, monthValue,
					dayValue, isFuzzyDate);

			propertyName = dateObjName;
			col.value = fullDate;
			col.name = propertyName;
			columns.push(col);
		} else {

			if (control.type == "select-one" && propertyName != 'month'
					&& propertyName != 'day') {
				col.name = propertyName;
				if (control.selectedIndex == -1) {
					col.value = null;
					col.lovId = -1;
				} else {
					col.value = control[control.selectedIndex].text.trim();
					col.lovId = control.value;
				}

				columns.push(col);

			} else if (control.type == "checkbox") {
				if (isElementArray(control.id)) {
					var ar = [];
					for (var ii = 0; ii < columns.length; ii++) {
						if (columns[ii].name == propertyName) {
							ar = columns[ii].value;
							break;
						}
					}

					ar.push(new Lov(control.value, control.checked).toString());
					// since we've modified the record; skip addding it.
					if (ar.length > 1)
						continue;

					col.value = ar;

				} else {
					col.name = propertyName;
					col.value = control.checked;
					columns.push(col);
				}

				// regular text input
			} else if (control.type == "text") {
				col.name = propertyName;
				col.value = control.value.trim();
				columns.push(col);
			}
		}
	}

	// Appending 1 empty row.
	if (!modify) {
		gridEl.appendGrid('appendRow', 1);
		numberOfRows = gridEl.appendGrid('getRowCount');
		lastRowIndex = numberOfRows - 1;
	}
	columns.forEach(function(record) {
		gridEl.appendGrid('setCtrlValue', record.name, lastRowIndex,
				record.value);
		if (record.lovId !== undefined) {
			// var uniqueIndex =
			// getElement(fullGridId).appendGrid('getUniqueIndex',
			// lastRowIndex);
			var cellCtrl = gridEl.appendGrid('getCellCtrl', record.name,
					lastRowIndex);
			if (cellCtrl !== null) {
				cellCtrl.setAttribute("data-lovid", record.lovId);
			}
		}
	});

	return lastRowIndex;
}

function Lov(lovId, selected, englishDescription, frenchDescription) {
	var that = this;

	if (!lovId) {
		that.lovId = eapp.webforms.constants.lovIdUnknown;
	} else {
		that.lovId = lovId;
	}

	that.selected = selected;
	if (arguments.length === 3) {
		that.longEnglishDescription = englishDescription;
	}

	if (arguments.length === 4) {
		that.longEnglishDescription = englishDescription;
		that.longFrenchDescription = frenchDescription;
	}

	that.toString = function() {
		var obj = {};
		obj.lovId = that.lovId;
		obj.selected = that.selected;
		obj.longEnglishDescription = that.longEnglishDescription;
		obj.longFrenchDescription = that.longFrenchDescription;
		return obj;
	};
}

function validateAgainstServer(modifiedRowIndex, gridId, divId) {
	var dataObj = getData();
	var jsonData = JSON.stringify(dataObj);

	$.ajax({
		url : "/eapp/showNext",
		data : jsonData,
		type : "POST",
		dataType : "json",

		beforeSend : function(xhr) {
			xhr.setRequestHeader("Accept", "application/json");
			xhr.setRequestHeader("Content-Type", "application/json");
		},

		// code to run if the request succeeds;
		// the response is passed to the function
		success : function(responseObject) {
			removeFixedErrors(responseObject.errors);
			// Error list does not refresh
			// added the below clear of previous errors from the list  
			var $errorsList = getElement("#form-error-list");
			$errorsList.empty();
			
			var errorsFlags = {};

			if (responseObject.errors !== null) {
				errorsFlags = addErrors(divId, responseObject.errors, false);
			}

			var gridEl = $("#tblAppendGrid_" + gridId);

			
			if (!errorsFound(errorsFlags)) {
				// re-set div content
				showHTML(responseObject, divId)

			} else {
				// disable saveAndExit button till all errors are fixed
				if (gridEl) {
					gridEl.appendGrid('removeRow', modifiedRowIndex);
				}
			}
		}
	});
}

function appendGridRow(gridId, divId) {
	var modifiedRowIndex = appendRow(gridId, divId);

	var containerId = gridId.replace(/_/g, ".")
	var nextAction = divId + "_append_" + containerId + "_" + Number(modifiedRowIndex + 1);
	setNextAction(nextAction);	
	
	validateAgainstServer(modifiedRowIndex, gridId, divId);
	updateGrid(gridId);

}

function errorsFound(errorsFlags) {
	return errorsFlags.nonMandatoryErrors || errorsFlags.mandatoryErrors;
}

function clearAllFields(divId) {
	var divControls = getAllFormControls(divId);
	$.each(divControls, function(index, control) {
		if (control.type == 'select-one') {
			control.selectedIndex = -1;
		} else if (control.type == 'checkbox') {
			control.checked = false;
		} else {
			control.value = "";
		}
	});
}

function getGridData(dataObj) {

	var allGrids = getElement('table[id^="tblAppendGrid"]');

	$.each(allGrids, function(index, tables) {
		var modelObjList = [];
		var gridId = "#" + tables.id;
		var gridEl = getElement(gridId);
		if (!gridEl.appendGrid('isReady')) {
			return;
		}
		var gridValues = gridEl.appendGrid("getAllValue");
		$.each(gridValues, function(index, value) {
			// index is row number
			var uniqueIndex = gridEl.appendGrid("getUniqueIndex", index);
			// var rowIndex = $('#tblAppendGrid').appendGrid('getRowIndex', 2);
			var modelObj = {};
			var properties = getPropertyNames(value);
			for (var i = 0; i < properties.length; i++) {
				var fieldName = properties[i];
				if ('divCol' == fieldName) {
					continue;
				}

				if ('selected' == fieldName) {
					modelObj.selected = value.selected;
					continue;
				}

				// get cell control
				var cellControl = gridEl.appendGrid("getCellCtrl", fieldName, index);
				addToJsonObject(fieldName, value[fieldName], modelObj, cellControl);
			}
			modelObj.id = index + 1;
			modelObj.rowNumber = modelObj.id;
			modelObjList[index] = modelObj;
		});

		var propertyName = gridId.substr(gridId.indexOf("_") + 1).replace( /_/gi, ".");
		if (propertyName.indexOf('.') > 0) {
			getObjectValue(propertyName, modelObjList, dataObj);
		} else {
			dataObj[propertyName] = modelObjList;
		}

	});

}

// grid column object

// columnName, labelText,controlType,size,readOnly
function createGridColumn(gridColumn) {

	var ctrlAttr = {};
	ctrlAttr.readonly = gridColumn.readOnly;
	// select control will look too ling if we apply size
	if (gridColumn.controlType != "select") {
		ctrlAttr.size = gridColumn.size;
	}

	var column = {};
	column.name = gridColumn.columnName;
	ctrlAttr["data-tableDescription"] = gridColumn.tableDescription;
	if (gridColumn.options !== undefined) {
		column.options = gridColumn.options;
	}
	if (gridColumn.tableCaption !== undefined) {
		ctrlAttr["data-tableCaption"] = gridColumn.tableCaption;		
	}

	if (gridColumn.labelText !== undefined) {
		column.display = gridColumn.labelText;
		ctrlAttr["data-display"] = gridColumn.labelText;
		ctrlAttr["aria-label"] = gridColumn.labelText;
	}

	if (gridColumn.invisible !== undefined) {
		column.invisible = true;
	}

	if (gridColumn.controlType == "select" && gridColumn.options !== undefined) {
		column.ctrlOptions = createGridOptions(gridColumn.options);
	}

	if (gridColumn.dataType == eapp.webforms.dataTypes.lov) {
		ctrlAttr["data-lovId"] = "";
		ctrlAttr["data-codeTableName"] = gridColumn.codeTableName;
	}

	column.type = gridColumn.controlType;
	ctrlAttr["data-dataType"] = gridColumn.dataType;

	column.ctrlAttr = ctrlAttr;
	column.ctrlClass = " form-control ignore grid-control full-width";
	return column;
}

function createGridOptions(webFormDictionaryList) {
	var resultedOptions = [];

	// add -1 option
	var option = {};

	$.each(webFormDictionaryList, function() {
		option = {};

		option.label = getLocalizedDescription(this);

		option.value = this.lovId;
		option.selected = false;

		resultedOptions.push(option);
	});

	return resultedOptions;
}

function updateOptions(gridControl, lov, selectName, rowIndex) {
	var uniqueIndexOfTheFirstRow = gridControl.appendGrid('getUniqueIndex', 0);
	var selectCtrl = gridControl.appendGrid('getCellCtrl', selectName, rowIndex);
	if (selectCtrl !== undefined && selectCtrl !== null) {
		var options = selectCtrl.options;
		if (options) {
			var length = selectCtrl.options.length;
			for (var i = 0; i < length; i++) {
				if (options[i].value == lov.lovId) {
					options[i].selected = true;
					return;
				}
			}
		}
	}
}

function getLocalizedDescription(object) {

	if (object === undefined)
		return "";

	var languageName = "English";
	if (eapp.webforms.locale.currentLanguageCode == eapp.webforms.constants.languageCodes.french) {
		languageName = "French";
	}

	var fullLanguageKey = "long" + languageName + "Description";
	if (object.hasOwnProperty(fullLanguageKey)) {
		return object[fullLanguageKey];
	} else {
		if (console)
			console.warn("Failed to find " + languageName + " description for object");
		return "";
	}
}

function createReadOnlyGrid(gridId, tableCaption, columns, initData, divId, idPrefix) {
	var gridColumns = [];
	var modifyRowLabel = eapp.webforms.locale.modifyRow;
	if (eapp.webforms.display.readOnlyMode) {
		modifyRowLabel = eapp.webforms.locale.viewRow;
	}
	var arr = gridId.split("_");
	var tableDescription = arr[arr.length - 1];
	for (var i = 0; i < columns.length; i++) {
		columns[i].tableCaption = tableCaption;
		columns[i].tableDescription = tableDescription;
		gridColumns.push(createGridColumn(columns[i]));
	}

	addSystemHiddenFields(gridColumns, divId, tableCaption);
	var gridControl = getElement('#tblAppendGrid_' + gridId);
	gridControl
			.appendGrid({
				initRows : 0,
				hideRowNumColumn : true,
				hideButtons : {
					insert : true,
					append : true,
					removeLast : true,
					moveUp : true,
					moveDown : true
				},
				columns : gridColumns,
				i18n : {
					rowEmpty : eapp.webforms.locale.rowEmpty

				},
				nameFormatter : function(idPrefix, name, uniqueIndex) {
					return (idPrefix + "." + name).replace(/_/g, ".") + "_"
							+ uniqueIndex;
				},
				idPrefix : idPrefix,
				customGridButtons : {
					remove : function() {
						var button = $("<button class='btn btn-default'></button>");
						button
								.append("<i class='icon icon-delete' aria-hidden='true'></i>"
										+ "<span class='sr-only-sm'>"
										+ eapp.webforms.locale.deleteRow
										+ "</span>");
						return button;
					}
				},
				customRowButtons : [ {
					uiButton : {
						icons : {
							primary : 'icon icon-edit'
						},

						label : modifyRowLabel,
						text : true
					},
					click : modifyActivity,
					btnClass : 'btn btn-default',
					btnAttr : {
						title : "Modify"
					},
					atTheFront : true
				} ]
			});

	// init grid with data
	initGridWithData(gridControl, gridColumns, initData);
	updateGrid(gridId);
	initGridHeadings('tblAppendGrid_' + gridId, tableCaption);
}

function isGridNotInitialized(gridId) {
	var gridEl = getElement("table[id='tblAppendGrid_" + gridId + "']");
	return gridEl && gridEl.length > 0 && gridEl.appendGrid('isReady') == false;
}

function createGrid(gridId, tableCaption, columns, initData, divId, idPrefix,
		isReadOnlyGrid, hideRowNumColumn) {

	if (isReadOnlyGrid) {
		createReadOnlyGrid(gridId, tableCaption, columns, initData, divId, idPrefix);

		return;
	}

	var gridColumns = [];
	var dataTypes = eapp.webforms.dataTypes;
	var locale = eapp.webforms.locale;
	var arr = gridId.split("_");
	var tableDescription = arr[arr.length - 1];
	for (var i = 0; i < columns.length; i++) {
		columns[i].tableDescription = tableDescription;
		columns[i].tableCaption = tableCaption;
		gridColumns.push(createGridColumn(columns[i]));
	}
	addSystemHiddenFields(gridColumns, divId, tableCaption);
	var gridControl = getElement('#tblAppendGrid_' + gridId);
	gridControl
			.appendGrid({
				initRows : 0,
				hideRowNumColumn : hideRowNumColumn,
				hideButtons : {
					insert : false,
					append : true,
					remove : false,
					removeLast : true,
					moveUp : true,
					moveDown : true
				},
				columns : gridColumns,
				i18n : {
					rowEmpty : eapp.webforms.locale.rowEmpty

				},
				nameFormatter : function(idPrefix, name, uniqueIndex) {
					if (idPrefix === '') {
						return (name).replace(/_/g, ".") + "_" + uniqueIndex;
					}
					return (idPrefix + "." + name).replace(/_/g, ".") + "_"
							+ uniqueIndex;
				},
				idPrefix : idPrefix,
				customGridButtons : {
					insert : function() {
						var button = $("<button class='btn btn-default'></button>");
						button
								.append("<i class='icon icon-plus' aria-hidden='true'></i><span class='sr-only-sm'>"
										+ eapp.webforms.locale.insertRow
										+ "</span>");
						return button;
					},

					remove : function() {
						var button = $("<button class='btn btn-default'></button>");
						button
								.append("<i class='icon icon-delete' aria-hidden='true'></i><span class='sr-only-sm'>"
										+ eapp.webforms.locale.deleteRow
										+ "</span>");
						return button;
					}
				}
			});

	// init grid with data
	initGridWithData(gridControl, gridColumns, initData);
	initGridHeadings('tblAppendGrid_' + gridId, tableCaption);
}
function updateGrid(gridId) {
	//Hide the inputs and show the value in plain text for accessibility
    $('#tblAppendGrid_'+gridId).find('input').each(function() {
    	if ($(this).attr('readonly')=='readonly') {
    		if($(this).prev().is('span')) {
    			$(this).prev().html(this.value);
    		} else {
    			$(this).addClass('wb-inv').before("<span>"+this.value+"</span>");
    			$(this).attr("tabindex", "-1");
    		}
    	}
    });
}


function addSystemHiddenFields(columns, divId, tableCaption) {
	if (divId === "")
		return;

	var columnWithIsSelected = {};
	columnWithIsSelected.name = "selected";
	columnWithIsSelected.type = "hidden";
	columnWithIsSelected.value = false;
	columns.push(columnWithIsSelected);

	var columnWithDivId = {};
	columnWithDivId.name = "divCol";
	columnWithDivId.type = "hidden";
	columnWithDivId.value = divId;
	columns.push(columnWithDivId);

	var idCol = {};
	idCol.name = "id";
	idCol.type = "hidden";
	idCol.tableCaption = tableCaption;
	columns.push(idCol);

}

// this is to specify Select grid column. This is editable field
function SelectGridColumn(columnName, labelText, options, codeTableName) {
	var that = this;
	this.columnName = columnName;
	this.labelText = charEntitiesToUnicode(labelText);
	this.controlType = "select";
	this.readOnly = false;
	this.dataType = eapp.webforms.dataTypes.lov;
	if (options !== undefined) {
		this.options = options;
	}
	if (codeTableName !== undefined) {
		this.codeTableName = codeTableName;
	}
	this.toString = function() {
		var obj = {};
		obj.columnName = that.columnName;
		obj.labelText = that.labelText;
		obj.controlType = that.controlType;
		obj.readOnly = that.readOnly;
		obj.dataType = that.dataType;
		obj.options = that.options;
		obj.codeTableName = that.codeTableName;
		return obj;
	};
}

/**
 * This is to specify text grid column. Text grid column should be mapped to the
 * data type of the corresponding field. If this is a String field, it should be
 * "text", if this is a Lov field, it should be "lov". If this is a WebFormDate
 * field, it should be "date", In case of the Lov field, you should also specify
 * codeTableName in order to later retrieve French or English text based on the
 * lovId. If this is just a String field, there is no need to specify
 * codeTableName
 */
function TextGridColumn(columnName, labelText, dataType, readOnly, size,
		codeTableName) {

	var that = this;
	this.columnName = columnName;
	this.labelText = charEntitiesToUnicode(labelText);
	this.controlType = "text";
	this.readOnly = readOnly;
	this.dataType = dataType;
	this.size = size;

	if (codeTableName !== undefined) {
		this.codeTableName = codeTableName;
	}

	this.toString = function() {
		var obj = {};
		obj.columnName = that.columnName;
		obj.labelText = that.labelText;
		obj.size = that.size;
		obj.controlType = that.controlType;
		obj.readOnly = that.readOnly;
		obj.dataType = that.dataType;
		obj.codeTableName = that.codeTableName;
		return obj;
	};
}

function Field(error) {
	var that = this;
	var fieldId = error.field, dashIndex = error.field.lastIndexOf("_");

	// we are looking for the grid field
	if (dashIndex > 0) {
		fieldId = error.field.substr(0, dashIndex);
	}
	this.uniqueId = "-1";
	this.fieldId = fieldId;
	this.path = error.objectName;
	this.fieldName = fieldId;
	this.fieldNameWithUniqueId = this.fieldName;
	this.fullFieldName = "";
	this.fullFieldNameWithUniqueId = "";
	this.fieldIdWithUniqueId = fieldId;
	this.rowNumber = -1;
	this.errorCode = error.code;
	this.errorMessage = error.message;
	this.ignoreError = error.ignoreError;
	if (this.path !== "") {
		this.fullFieldName = this.path + "." + this.fieldName;
	}
	if (dashIndex > 0) {
		this.rowNumber = error.rowNumber;
		this.uniqueId = error.field.substr(dashIndex + 1);
		this.fullFieldNameWithUniqueId = this.fullFieldName + "_"
				+ this.uniqueId;
		this.fieldNameWithUniqueId = this.fieldNameWithUniqueId + "_"
				+ this.uniqueId;
		this.fieldIdWithUniqueId = this.fieldIdWithUniqueId + "_"
				+ this.uniqueId;
	} else {

	}
	if (isDateField(this.fieldName)) {
		this.fullFieldName = this.fullFieldName + ".year";
		this.fieldId = this.fieldId + "-year";
	}

	this.toString = function() {
		var obj = {};
		obj.fieldId = that.fieldId;
		obj.path = that.path;
		obj.fieldName = that.fieldName;
		obj.fullFieldName = that.fullFieldName;
		obj.rowNumber = that.rowNumber;
		obj.fieldNameWithUniqueId = that.fieldNameWithUniqueId;
		obj.fullFieldNameWithUniqueId = that.fullFieldNameWithUniqueId;
		obj.fieldIdWithUniqueId = that.fieldIdWithUniqueId;
		obj.errorCode = that.errorCode;
		obj.ignoreError = that.ignoreError;
		obj.errorMessage = that.message;
		return obj;
	};
}

function HiddenGridColumn(columnName, labelText, dataType, codeTableName) {
	var that = this;
	this.columnName = columnName;
	this.labelText = charEntitiesToUnicode(labelText);
	this.controlType = "text";
	this.invisible = true;
	this.readOnly = true;
	this.dataType = dataType;

	if (arguments.length === 3) {
		this.codeTableName = codeTableName;
	}

	this.toString = function() {
		var obj = {};
		obj.columnName = that.columnName;
		obj.labelText = that.labelText;
		obj.controlType = that.controlType;
		obj.readOnly = that.readOnly;
		obj.dataType = that.dataType;
		obj.codeTableName = that.codeTableName;
		return obj;
	};
}

function initGridWithData(gridControl, columns, initData) {
	if (initData && initData !== null && initData.length > 0) {
		// add empty rows
		gridControl.appendGrid('appendRow', initData.length);

		// loop through all rows
		var initDatalnt = initData.length;
		var colCount = columns.length;
		var dictionary = eapp.webforms.dictionary;
		for (var i = 0; i < initDatalnt; i++) {

			// loop through all columns to set their values
			for (var ii = 0; ii < colCount; ii++) {
				var value;
				value = getObjFieldValue(columns[ii].name, initData[i]);
				setGridColumnWithValue(columns[ii], value, gridControl, i, dictionary);
			}
		}
	}
}
function setGridColumnWithValue(column, fieldValue, gridControl, rowIndex,
		dictionary) {
	if (!gridControl.appendGrid('isReady')) {
		return;
	}
	var dataTypes = eapp.webforms.dataTypes;
	if (fieldValue === undefined && column.ctrlAttr !== null && column.ctrlAttr["data-dataType"] != dataTypes.lovList) {
		return;
	}

	if (column.name === "selected") {
		gridControl.appendGrid('setCtrlValue', column.name, rowIndex, fieldValue);
		return;
	}

	if (column.ctrlAttr === null) {
		return;
	}

	var ctrlDataType = column.ctrlAttr["data-dataType"];
	var date;

	if (ctrlDataType == dataTypes.date) {
		date = getWebFormDateAsString(fieldValue, false);
		gridControl.appendGrid('setCtrlValue', column.name, rowIndex, date);

	} else if (ctrlDataType == dataTypes.fuzzyDate) {
		date = getWebFormDateAsString(fieldValue, true);
		gridControl.appendGrid('setCtrlValue', column.name, rowIndex, date);

	} else if (ctrlDataType == dataTypes.text) {
		gridControl.appendGrid('setCtrlValue', column.name, rowIndex, fieldValue);

	} else if (ctrlDataType == dataTypes.lov) {

		var codeTableName = column.ctrlAttr["data-codeTableName"];
		if (codeTableName && codeTableName !== null && codeTableName !== "") {
			var list = dictionary[codeTableName];
			var lovText = getLovText(list, fieldValue.lovId);
			gridControl.appendGrid('setCtrlValue', column.name, rowIndex, lovText);

		}

		var cellCtrl = gridControl.appendGrid('getCellCtrl', column.name,
				rowIndex);
		if (cellCtrl !== null) {
			cellCtrl.setAttribute("data-lovid", fieldValue.lovId);
		}

		if (column.options) {
			updateOptions(gridControl, fieldValue, column.name, rowIndex);
		}

	} else if (ctrlDataType == dataTypes.boolLov) {
		gridControl.appendGrid('setCtrlValue', column.name, rowIndex,
				fieldValue.selected);

	} else if (ctrlDataType == dataTypes.bool) {
		gridControl.appendGrid('setCtrlValue', column.name, rowIndex,
				fieldValue);
	}

	// else if (ctrlDataType == dataTypes.lovList) {
	// if (column.options) {
	// updateOptions(gridControl, fieldValue, column.name, rowIndex);
	// }

	// }
}
function getLovText(list, lovId) {
	if (list !== undefined) {
		for (var i = 0, il = list.length; i < il; i++) {
			if (list[i].lovId == lovId) {
				return getLocalizedDescription(list[i]);
			}
		}
	}

	return "";
}

function getObjFieldValue(fullFieldPath, obj) {
	var splits = fullFieldPath.split('.');
	var fieldName = splits.pop();
	var len = splits.length;
	var ii = 1;
	var i = splits[0];
	var childObj;
	while ((childObj = obj[i]) && ii < len) {
		i = splits[ii];
		ii += 1;
	}
	if (childObj) {
		return childObj[fieldName];
	}
	return obj[fieldName];
}

function getData() {
	var dataObj = {};
	// round up all form properties
	var properties = getElement("#webForm .formProperty");
	if (properties && properties.length > 0) {
		buildDataObject(properties.serializeArray(), dataObj);
	}

	// round up all form controls & values
	var elements = getAllFormControls("webForm").not(".ignore");
	if (elements && elements.length > 0) {
		var ary = [];
		$.each(elements, function(index, value) {
			var obj = {
				name : value.name,
				value : value.value.trim(),
				id : value.id,
				type : value.type
			};

			if (value.type == 'checkbox') {
				obj.checked = value.checked;
			} else if (value.type == 'select-one') {
				obj.isFuzzy = $(value).hasClass("fuzzy-date");
			}

			ary.push(obj);
		});

		buildDataObject(ary, dataObj);
	}

	// round up all grid data (if applicable)
	getGridData(dataObj);

	return dataObj;
}

function buildDataObject(elements, dataObj) {
	var lnt = elements.length;
	for (var a = 0; a < lnt; a++) {
		var element = elements[a], name = element.name;

		if (name === "")
			continue;

		var value = element.value;
		if (name.indexOf('reenterPrCardNumber') >= 0) {
			continue;

		} else if (name.indexOf('.') > 0) {
			getObjectValue(name, value, dataObj);

		} else {
			if ((element.type && element.type == 'select-one')
					|| isSelectionField(name)) {
				setSelectedValue(name, value, dataObj);

			} else {
				if (value.indexOf('{') >= 0) {
					dataObj[name] = JSON.parse(value);
				} else {
					dataObj[name] = value;
				}
			}
		}
	}
}

function addToJsonObject(fieldPath, fieldValue, modelObj, cellControl) {
	// get value of the data type attribute of the cell control
	var dataType = cellControl.getAttribute("data-datatype");
	var lovId = cellControl.getAttribute("data-lovid");

	if (dataType == eapp.webforms.dataTypes.lov
			&& cellControl.type != "select-one") {
		fieldValue = lovId;
	}

	// this is to get the name of the field without the path, in case of In case
	// of country.provinceCityLocation.province, it will be province
	var fieldName = getPropertyName(fieldPath);
	if (fieldPath.indexOf(".") > 0) {
		// re-create the object based on the fieldPath. If the field path is
		// country.provinceCityLocation.province, then the return of this
		// function will
		// object country.provinceCityLocation
		var field = createObject(fieldPath, modelObj);
		field[fieldName] = getFieldValue(dataType, fieldValue);
		
	} else {
		modelObj[fieldName] = getFieldValue(dataType, fieldValue);
	}
}

// now we need to get value of the field.
function getFieldValue(dataType, fieldValue) {
	var dataTypes = eapp.webforms.dataTypes;

	if (dataType == dataTypes.text) {
		return (fieldValue + "").trim();

	} else if (dataType == dataTypes.lov) {
		return new Lov(fieldValue, true);

	} else if (dataType == dataTypes.bool) {
		return fieldValue;

	} else if (dataType == dataTypes.boolLov) {
		return new Lov(-1, fieldValue === "true" ? true : false);

	} else if (dataType == dataTypes.lovList) {
		return new Lov(fieldValue, true);

	} else if (dataType == dataTypes.date) {
		return getWebFormDate(fieldValue, false);

	} else if (dataType == dataTypes.fuzzyDate) {
		return getWebFormDate(fieldValue, true);
	}

	return null;
}

function createObject(fieldPath, dataObj) {
	var obj = {};
	// get the the name of the root object. in case of
	// country.provinceCityLocation.province, it will be country
	var splittedFieldPath = fieldPath.split(".");
	var objectName = splittedFieldPath[0];

	if (dataObj[objectName] === undefined) {
		dataObj[objectName] = obj;
	} else {
		obj = dataObj[objectName];
	}

	var lnt = splittedFieldPath.length - 1;
	// we already created root object (obj), no we need to re-create the rest of
	// the path. In case of country.provinceCityLocation.province,
	// it will be everything between country and province. In our example it
	// will be provinceCityLocation
	for (var i = 1; i < lnt; i++) {
		// retrieve first child object of the root. In our example, it will be
		// provinceCityLocation
		objectName = splittedFieldPath[i];
		// create new object if it has not being defined before
		if (obj[objectName] === undefined) {

			obj[objectName] = {};
			// return reference the newly created object. In our case, obj will
			// be provinceCityLocation

			if (i <= lnt - 1) {
				obj = obj[objectName];
			}
			// return reference to the already created object
		} else {
			obj = obj[objectName];

		}
	}
	return obj;
}

function getObjectValue(fieldPath, fieldValue, dataObj) {
	var fieldName = getPropertyName(fieldPath);
	if (fieldName === null)
		return;

	// re-create the object based on the fieldPath. If the field path is
	// country.provinceCityLocation.province, then the return of this function
	// will
	// object country.provinceCityLocation
	var obj = createObject(fieldPath, dataObj);

	if (isSelectionField(fieldPath)) {
		if (!isNaN(fieldValue)) {
			var selectedValue = {};
			selectedValue = new Lov(fieldValue, true);
			obj[fieldName] = selectedValue;
		}

	} else if (isCheckboxField(fieldPath)) {
		var lov;
		if (fieldValue === "")
			fieldValue = -1;

		var isArray = isElementArrayByName(fieldPath);
		if (isArray) {
			lov = new Lov(fieldValue, isSelectionElementChecked($("#"
					+ fieldName + "-" + fieldValue)));
		} else {
			lov = new Lov(fieldValue,
					isSelectionElementChecked($("input[name='" + fieldPath
							+ "']")));
		}

		if (obj[fieldName] === undefined) {
			if (isArray) {
				obj[fieldName] = [];
			} else {
				obj[fieldName] = {};
			}
		}

		if (isArray) {
			var len = obj[fieldName].length;
			obj[fieldName][len] = lov;
		} else {
			obj[fieldName] = lov;
		}
		return;

	} else {
		obj[fieldName] = fieldValue;
	}
}

function getElementType(element) {
	if (element)
		return element.prop("type");
}

function getElementId(element) {
	if (element)
		return element.prop("id");
}

function isSelectionElementChecked(element) {
	if (element)
		return element.is(":checked");
}

function isElementArray(elementName) {
	if (elementName) {
		var index = elementName.indexOf("-");
		if (index > 0) {
			var arrayName = elementName.substr(0, index);
			var e = getElement(".isArray-" + arrayName);
			return (e && e.length > 0);
		} else
			return false;
	} else
		return false;
}

function isElementArrayByName(elementName) {
	var e = getElement("input[name='" + elementName + "']");
	return (e && e.length > 1);
}

function setSelectedValue(fieldName, fieldValue, dataObj) {
	if (isNaN(fieldValue)) {
		return;
	}

	var selectedValue = {};
	selectedValue = new Lov(fieldValue, true);
	dataObj[fieldName] = selectedValue;
}

function isSelectionField(fieldName) {
	return isFieldType(fieldName, "select-one");
}

function isCheckboxField(fieldName) {
	return isFieldType(fieldName, "checkbox");
}

function isFieldType(fieldName, fieldType) {
	return (getElementType(getElement("[name='" + fieldName + "']")) == fieldType)
			|| (getElementType(getElement("#" + fieldName)) == fieldType);
}

function getPropertyName(name) {
	var splittedPropAr = name.split(".");
	return splittedPropAr[splittedPropAr.length - 1];
}

function clearGrid(id) {
	var grid = getElement('#' + id);
	if (grid && grid.length == 1) {
		var rowCount = grid.appendGrid('getRowCount');
		for (var i = 0; i < rowCount; i++) {
			grid.appendGrid('removeRow', i);
		}
	}
}

function cleanJQuerySelection(id) {
	return id.replace(/[^\w\s]/gi, '\\$&');
}

function subscribeToProvinceChange(provinceId, cityId, cityValueId) {
	$('#webForm').on(
			'change',
			'#' + cleanJQuerySelection(provinceId),
			function(e) {
				if (e && e.currentTarget) {
					if (e.currentTarget.value == -1) {
						getElement("#" + cityId).empty().append(
								'<option value="-1"></option>');
					} else {
						populateCityListByProvinceId(e.currentTarget.value,
								cleanJQuerySelection(cityId), cityValueId);
					}

				}
			});
}

function subscribeToIsOngoingDate(subscribeId, fieldName) {
	subscribeToElementChange(subscribeId, function(event) {
		var config = {};
		config["false"] = fieldName;
		if (event.currentTarget.checked == true) {
			clearElement(fieldName + "-year");
			clearElement(fieldName + "-month");
			clearElement(fieldName + "-day");
		}

		showNext(fieldName + "Content", event.currentTarget.id, config);
	});
}

function subscribeToIsOngoingElement(subscribeId, fieldName) {
	subscribeToElementChange(subscribeId, function(event) {
		var config = {};
		config["false"] = fieldName;
		if (event.currentTarget.checked == true) {
			clearElement(fieldName);
		}

		showNext(fieldName + "Content", event.currentTarget.id, config);
	});
}

function subscribeToElementChange(elementId, callback) {
	$('#webForm').on('change', '#' + cleanJQuerySelection(elementId),
			function(e) {
				if (e && e.currentTarget) {
					callback(e);
				}
			});
}
function subscribeToTextareaChange(elementId) {
$("textarea#" + cleanJQuerySelection(elementId)).bind('paste',
			function(e) {
				var elem = $(this);
				setTimeout(function() {
					// gets the copied text after a specified time (100 milliseconds)
					var text = elem.val();
					// smart single quotes and apostrophe
				    text = text.replace(/[\u2018\u2019\u201A]/g, "\'");
				    // smart double quotes
				    text = text.replace(/[\u201C\u201D\u201E]/g, "\"");
				    // ellipsis
				    text = text.replace(/\u2026/g, "...");
				    // dashes
				    text = text.replace(/[\u2013\u2014\u2022]/g, "-");
				    // circumflex
				    text = text.replace(/\u02C6/g, "^");
				    // open angle bracket
				    text = text.replace(/\u2039/g, "<");
				    // close angle bracket
				    text = text.replace(/\u203A/g, ">");
				    // spaces
				    text = text.replace(/[\u02DC\u00A0]/g, " ");
					elem.val(text);
				}, 100);
			});
}

/** Helper function for subscribing to yes choices on components * */
function subscribeToYesElement(id) {
	subscribeToElementChange(id, function(event) {
		var config = {};
		config[eapp.webforms.constants.yesNo.yes] = id;
		showNext(id + "Content", id, config);
	});
}

function populateSelectList(el, lovList, selectedLovId) {
	if (!lovList) {
		return;
	}

	if (el === undefined || el.type !== "select-one") {
		if (console)
			console.log("Error. el is not a select control");
		return;
	}

	var fragment = document.createDocumentFragment(), option, selectedIndex = 0;

	if (lovList[0].lovId !== -1) {
		option = document.createElement("OPTION");
		option.value = -1;
		fragment.appendChild(option);
	}

	for (var i = 0, il = lovList.length; i < il; i++) {
		option = document.createElement("OPTION");
		option.value = lovList[i].lovId;
		option.text = getLocalizedDescription(lovList[i]);

		if (lovList[i].lovId === selectedLovId) {
			// selectedIndex is next index on the fragment list
			selectedIndex = (i + 1);
		}

		fragment.appendChild(option);
	}

	el.innerHTML = "";
	el.appendChild(fragment.cloneNode(true));

	if (selectedIndex > 0 && el.childNodes && el.childNodes.length > 0) {
		el.childNodes[selectedIndex].selected = true;
	}
}

function fetchCityListForProvince(provinceId, callback, config) {
	if (typeof provinceId === "undefined")
		return;

	if (provinceId === 0)
		return;

	if (!callback || !jQuery.isFunction(callback)) {
		return;
	}

	var provinces = eapp.webforms.cache.provinces;
	var cityList;
	$.each(provinces, function() {
		if (this.id == provinceId) {
			cityList = this.list;
			return false;
		}
	});

	if (cityList && cityList.length > 0) {
		callback(cityList, config);
	} else {
		$.ajax({
			url : "/eapp/cityListByProvince/" + provinceId,
			type : "GET",
			cache : false,
			dataType : "json",

			beforeSend : function(xhr) {
				xhr.setRequestHeader("Accept", "application/json");
				xhr.setRequestHeader("Content-Type", "application/json");
			},
			success : function(responseObject) {
				var province = {};
				province.id = "" + provinceId;
				province.list = responseObject;
				eapp.webforms.cache.provinces.push(province);
				callback(responseObject, config);
			}
		});
	}
}

function populateCityListByProvinceId(provinceId, outputDivId, selectedCityId) {
	if (typeof provinceId === "undefined")
		return;

	if (provinceId === 0)
		return;

	var el = getElement("#" + outputDivId);
	if (el.length === 0) // no output element available
		return;

	fetchCityListForProvince(provinceId, function(list) {
		populateSelectList(el[0], list, selectedCityId, outputDivId);
	});
}

function showNextQuestions(url, divName, panelId, outputDivId,
		completionCallback, selectedElement) {

	if (!url) {
		url = "/eapp/showNext";
	}

	var dataObj = getData();
	var jsonData = JSON.stringify(dataObj);

	$.ajax({
		url : url,
		data : jsonData,
		type : "POST",
		dataType : "json",
		beforeSend : function(xhr) {
			xhr.setRequestHeader("Accept", "application/json");
			xhr.setRequestHeader("Content-Type", "application/json");
			$(selectedElement).attr('disabled', 'disabled');
		},
		// code to run if the request succeeds;
		// the response is passed to the function
		success : function(responseObject) {
			removeFixedErrors(responseObject.errors);
			// go to the next section in spite of errors
			var errorsFlags = {};
			if (url.indexOf("showNext") > 0) {
				// enable all panels
				enable();
				if (responseObject.errors !== null) {
					errorsFlags = addErrors(divName, responseObject.errors,
							false);
				}

				// display "Next" panel, if there are no non-mandatory errors.
				// We need to ignore mandatory errors to allow saving empty
				// fields on "Next".
				if (!errorsFlags.nonMandatoryErrors) {
					// show "Next" panel
					if (panelId !== null) {
						getElement("#accordion").accordion({
							active : panelId
						});

						// focus on first tabbable element in "Next" panel
						webFormAccessibility
								.focusOnFirstTabbableElement(panelId);

						addCompletionStatus(
								responseObject.webForm.webFormStatus,
								errorsFlags, panelId - 1);
					} else {
						showHTML(responseObject, outputDivId);
					}
				} else {
					// prevent displaying "Next" panel if user entered
					// invalid data
					if (panelId !== null) {
						disable(panelId);
						addCompletionStatus(
								responseObject.webForm.webFormStatus,
								errorsFlags, panelId - 1);
					}

				}

			} else if (url.indexOf("submitWebForm") > 0) {

				errorsFlags = {};
				if (responseObject.errors !== null) {
					errorsFlags = addErrors("accordion", responseObject.errors,
							false);
					if (errorsFlags.nonMandatoryErrors) {
						return;
					}
				}

				window.location.href = "/eapp/applicationChecklist";
			} else {
				// enable all panels
				enable();
			}

			// callback to be triggered when ajax call is completed.
			// Needed to trigger any evaluation that requires the next
			// section to be up already.
			if ((typeof completionCallback !== "undefined")
					&& jQuery.isFunction(completionCallback)) {
				completionCallback();
			}

			$(selectedElement).removeAttr('disabled');
			$(selectedElement).focus();
			setNextAction("");
		}
		
	});

}
function disable(panelId) {
	var allAccordionHeaders = $(".ui-accordion-header");
	var lnt = allAccordionHeaders.length;
	for (var i = 0; i < lnt; i++) {
		var id = allAccordionHeaders[i].id, headerId = Number(id.substr(id
				.lastIndexOf("-") + 1));

		if (headerId >= panelId) {
			$("#ui-accordion-accordion-header-" + i).addClass(
					"ui-state-disabled");
		}
	}

	disableSaveAndExit();
}

function addCompletionStatus(webFormStatus, errorsFlags, headerIndex) {
	var statusText = eapp.webforms.status.text.notStarted;
	var statusTextComplete = eapp.webforms.status.text.complete;
	var statusTextInProgress = eapp.webforms.status.text.inProgress;
	var statusClass = 'eapp-status-not-started';
	if (webFormStatus != "form_status.not_started") {
		var inProgress = errorsFlags.nonMandatoryErrors
				|| errorsFlags.mandatoryErrors;

		statusText = inProgress ? statusTextInProgress : statusTextComplete;
		statusClass = inProgress ? 'eapp-status-in-progress'
				: 'eapp-status-complete';
	}

	var el = '#ui-accordion-accordion-header-' + headerIndex;

	getElement(el + ' .eapp-status-icon').remove();
	getElement(el + ' .eapp-status-text').remove();
	getElement(el)
			.append(
					'<i class="icon eapp-status-icon" aria-hidden="true"></i><span class="eapp-status-text wb-inv" role="status">'
							+ 'Status: ' + statusText + '</span>');
	getElement(el)
			.removeClass(
					'eapp-status-not-started eapp-status-in-progress eapp-status-complete')
			.addClass(statusClass);

}

function loadData(webFormId, section) {
	$.ajax({
		url : "/eapp/loadData?webFormId=" + webFormId + "&section="
				+ section,
		type : "GET",
		cache : false,
		dataType : "json",
		beforeSend : function(xhr) {
			xhr.setRequestHeader("Accept", "application/json");
			xhr.setRequestHeader("Content-Type", "application/json");
		},
		success : function(responseObject) {
			if (responseObject.dictionary) {
				eapp.webforms.dictionary = responseObject.dictionary;
			}

			if (responseObject.webForm) {
				// call up any init method if we have one available.
				if ((typeof initialize !== "undefined")
						&& jQuery.isFunction(initialize)) {
					initialize(webFormId, responseObject.webForm);
				}

				addPanelCompletionStatus(responseObject.webForm.webFormStatus);
			}
		}

	});
}

function isFieldHidden(id) {
	if (typeof id === 'string') {
		return $("#" + id).is(":hidden");
	} else {
		return undefined;
	}

}

function setFocus(errorLinkId) {

	var id = '';

	if (typeof errorLinkId !== 'string' || errorLinkId.length < 7)
		return;

	var iError = errorLinkId.indexOf('-error');

	if (iError === -1)
		return;

	var fieldId = errorLinkId.slice(0, iError);

	// Remove number at end, if the link refers to a grid cell
	var iUnderscore = fieldId.lastIndexOf('_');
	if (iUnderscore !== -1) {
		var sIndex = fieldId.substr(iUnderscore + 1);
		if (sIndex.length > 0 && $.isNumeric(sIndex)) {
			fieldId = fieldId.slice(0, iUnderscore);
		}
	}

	id = '';

	// Look for table description for grid
	var tableDescription = $("#table-description-" + fieldId);
	if (tableDescription.length === 1) {
		id = 'table-description-' + fieldId;

		// Failed to find table description; look for field or div with
		// specified id
	} else if (tableDescription.length === 0) {
		var field = $("input[id='" + fieldId + "'], textarea[id='" + fieldId
				+ "'], select[id='" + fieldId + "'], div[id='" + fieldId + "']");
		if (field.length === 1)
			id = fieldId;

		// For most fields, jump to question and answer container
		var qa = $(field).parents(".eapp-question-and-answer");
		if ($(qa).length === 1) {
			$(qa).attr("tabindex", "-1");
			id = $(qa).attr("id");
			if (typeof id !== 'string' || id.length === 0) {
				id = 'eapp-question-and-answer-' + fieldId;
				$(qa).attr("id", id);
			}
		}

		// For date fields, jump to question description if it can be found
		if ($(field).is("select") && $(field).length === 1) {
			var dateContainer = $(field).parents(".question-date");
			if ($(dateContainer).length === 1) {
				var idDescription = $(dateContainer).attr("aria-describedby");
				if (typeof idDescription === 'string'
						&& idDescription.length > 0)
					id = idDescription;

			}
		}
	}

	if (id.length === 0)
		return;

	var attrWithPanelId = $("#" + id).closest("div[role='tabpanel']").attr(
			"aria-labelledby");
	attrWithPanelId = $.trim(attrWithPanelId || '');

	var panelId = '';
	var activePanelId = '';
	if (attrWithPanelId.length > 0) {
		if (attrWithPanelId.indexOf('ui-accordion-accordion-header-') === 0)
			panelId = $.trim(attrWithPanelId.replace(
					'ui-accordion-accordion-header-', ''));

		var activePanelId = $.trim(activePanel());
	}

	if (activePanelId === panelId) {

		// If the field is within the active accordion panel, scroll to the
		// field or div
		// Check for hidden element - IE will return error if field is hidden
		if (isFieldHidden(id) !== true) {
			$("#" + id).focus();
			$(window).scrollTop($("#" + id).offset().top);
		}

		$("#accordion").accordion("refresh");

	} else {

		// If the field is within a closed accordion panel, open the panel and
		// scroll to the field or div

		$("#accordion").off("accordionactivate");

		$("#accordion").one("accordionactivate", function(event, ui) {

			// Check for hidden element - IE will return error if field is
			// hidden
			if (isFieldHidden(id) !== true) {
				$("#" + id).focus();
				$(window).scrollTop($("#" + id).offset().top);
			}

			$("#accordion").on("accordionactivate", function(event, ui) {
				$(window).scrollTop(ui.newHeader.offset().top);
			});
		});

		$("#accordion").accordion({
			active : Number(panelId)
		});

		$("#accordion").accordion("refresh");
	}

}

function linkTextContents(sel) {

	var $el = $(sel), linkText = "";

	// filter text nodes + p, span, strong and em tags
	var $linkText = $el
			.contents()
			.filter(
					function(index) {
						return (this.nodeType === Node.TEXT_NODE || (this.nodeType === Node.ELEMENT_NODE && $(
								this).is("p, span, strong, em")));
					});

	for (var i = 0, len = $linkText.length; i < len; i++) {
		if (i > 0 && $linkText[i].nodeType !== Node.TEXT_NODE)
			linkText += " "; // add space, if not a text node

		linkText += $($linkText[i]).text().replace(/^\s+|\s+$/gm, ''); // trim
		// text

	}

	linkText = linkText.replace(/[\t\r\n\f]/g, ''); // strip tabs, cr, lf, ff

	linkText = trimFinalColon(linkText);

	return linkText;

}

function trimFinalColon(linkText) {

	var s = linkText.replace(/^\s+|\s+$/gm, ''); // trim text
	var iColon = s.lastIndexOf(":");
	if (iColon !== -1 && (iColon === s.length - 1))
		s = s.slice(0, iColon);

	return s.replace(/^\s+|\s+$/gm, '');
}

function addErrors(divId, errors, checkFieldCompletion) {

	if (errors === null)
		return {};

	var panelControls = getAllFormControls(divId);
	var errorsFlags = {};
	errorsFlags.nonMandatoryErrors = false;
	errorsFlags.mandatoryErrors = false;

	var $errorsList = getElement("#form-error-list");
	$errorsList.empty();
	
	var len = errors.length;
	for (var a = 0; a < len; a++) {
		var field = new Field(errors[a]);

		// don't show error message when the errorCode is error.DateGap and the
		// check field completion button was not clicked.
		if (field.errorCode === "error.DateGap" && checkFieldCompletion != true) {
			continue;
		}

		var $failingControl = findFailingFormControl(field, panelControls);
		if ($failingControl == null)
			continue;

		if (!checkFieldCompletion === true) {
			if (field.ignoreError) {
				errorsFlags.mandatoryErrors = true;
				// do not display mandatory errors
				continue;
			}

		}

		errorsFlags.nonMandatoryErrors = true;

		var $fieldLabelOrDescription = getFieldLabelOrDescription($failingControl);
		if ($fieldLabelOrDescription != null) {
			addErrorClass($fieldLabelOrDescription);
			addErrorIndicatorImage($fieldLabelOrDescription);
			addErrorMessage($fieldLabelOrDescription, field, $errorsList);

		}

	}

	if (errorsFlags.nonMandatoryErrors === true) {
		showValidationErrorsDiv();
		enableSaveAndExit();
	}
	hideRequiredFieldsStatusDiv();

	eappAddIcons();
	updateErrorAttributesFields("question-label");
	updateErrorAttributesFields("question-description");

	return errorsFlags;
}

function getFieldLabelOrDescriptionForFieldId(fieldId, questionClass) {
	var el, $el;
	if (questionClass === "question-label") {
		el = "label[for='" + fieldId + "']";
	} else if (questionClass === "question-description") {
		el = "#question-description-" + fieldId;
	} else if (questionClass === "table-description") {
		el = "#table-description-" + fieldId;
	} else if (questionClass === "grid-control") {
		el = "#" + fieldId;

	}
	$el = $(el);
	return $el;
}

function removeYearSuffix(id) {
	if (id == undefined)
		return id;
	var indexOfYear = id.indexOf("-year");
	if (indexOfYear > 0) {
		return id.substr(0, indexOfYear);
	} else {
		return id;
	}

}

function removeTelphoneSuffixes(id) {
	if (id == undefined)
		return id;
	var indexOfAreaCode = id.indexOf("AreaCode");
	if (indexOfAreaCode > 0) {
		return id.substr(0, indexOfAreaCode);
	}
	var indexOfExchangeNumber = id.indexOf("ExchangeNumber");
	if (indexOfExchangeNumber > 0) {
		return id.substr(0, indexOfExchangeNumber);
	}
	var indexOfSubscriberNumber = id.indexOf("SubscriberNumber");
	if (indexOfSubscriberNumber > 0) {
		return id.substr(0, indexOfSubscriberNumber);
	}

	return id;
}


function getFieldLabelOrDescription(control) {

	var el, $el;
	if (control.hasClass("grid-control")) {
		return control;
	}
	el = "label[for='" + control.attr("id") + "']";
	$el = $(el);
	if ($el.length) {
		return $el;
	}

	var dateId = removeYearSuffix(control.attr("id"));

	el = "#question-description-" + dateId;
	$el = $(el);
	if ($el.length) {
		return $el;
	}

	el = "#table-description-" + control.attr("id");
	$el = $(el);
	if ($el.length) {
		return $el;
	}

	var telephoneId = removeTelphoneSuffixes(control.attr("id"));

	el = "#question-description-"  + telephoneId;
	$el = $(el);
	if ($el.length) {
		return $el;
	}
	
	// errorIndicatorClass = "table-error-indicator";

	// el = "input[name='" + field.fullFieldNameWithUniqueId + "'] .ignore";
	// el = "#table-description-" + $gridControl.attr("data-tableDescription");

	return null;

}

function addErrorClass(el, field) {
	if (el.length) {
		if (el.hasClass("question-description")) {
			el.removeClass("question-description").addClass(
					"question-description-error");

		} else if (el.hasClass("table-description")) {
			el.removeClass("table-description").addClass(
					"table-description-error");

		} else if (el.hasClass("grid-control")) {
			el.removeClass("grid-control").addClass("grid-control-error");

		} else if (el.hasClass("question-label")) {
			el.removeClass("question-label").addClass("question-label-error");

		}

	}
}

function addErrorIndicatorImage(el) {
	var errorIndicatorClass = "question-error-indicator";
	if (el.hasClass("table-description-error")) {
		errorIndicatorClass = "table-error-indicator";
	} else if (el.hasClass("question-label-error")) {
		errorIndicatorClass = "question-error-indicator";
	} else if (el.hasClass("grid-control-error")) {
		errorIndicatorClass = "table-error-indicator";
		var tableSel = "#table-description-" + el.attr("data-tableDescription");
		el = $(tableSel);

	}
	// check if image has already being added.
	if (el.children().hasClass(errorIndicatorClass)) {
		return;
	}
	var errorIndicatorAlt = eapp.webforms.locale.errorField;
	$(el)
			.prepend(
					"<span class='"
							+ errorIndicatorClass
							+ "'><span class='fa fa-arrow-right'></span>"
							+ errorIndicatorAlt
							+ "</span>");
}

function addErrorMessage(el, field, $errorsList) {
	var href = field.fieldId, linkId = field.fieldId + "-error", linkText = linkTextContents(el), message = field.errorMessage;

	if (el.hasClass("grid-control-error")) {
		var fieldDisplay = el.attr("data-display");
		var tableCaption = el.attr("data-tableCaption");
		var tableDescription = el.attr("data-tableDescription");
		var rowNumber = field.rowNumber;
		linkId = field.fieldIdWithUniqueId + "-error";
		href = "table-description-" + tableDescription;
		linkText = eapp.webforms.locale.table + eapp.webforms.locale.colon
				+ " " + tableCaption;
		message = eapp.webforms.locale.row + eapp.webforms.locale.colon + " "
				+ rowNumber + " " + eapp.webforms.locale.field
				+ eapp.webforms.locale.colon + " " + fieldDisplay + " "
				+ field.errorMessage;
	} else if (el.hasClass("table-description-error")) {
		href = "table-description-" + field.fieldId;
	} else if (el.hasClass("question-description-error")) {
		var indexOfYear = field.fieldId.indexOf("-year");
		if (indexOfYear > 0) {
			href = "question-description-"
					+ field.fieldId.substr(0, indexOfYear);
		} else {
			href = "question-description-" + field.fieldId;
		}

	}
	// check if this error message already exists.
	var $errorLink = $("#" + linkId);
	if ($errorLink) {
		if ($errorLink.attr("data-errorCode") === field.errorCode)
			return;
	}

	//cleanup unwanted HTML from CMS
	message = "<li><span class='form-error-prefix'>"
			+ eapp.webforms.locale.prefixErrorDescription + "</span> "
			+ "<span class='form-error'>" + "<a id='" + linkId + "' "
			+ "data-errorCode='" + field.errorCode + "' "
			+ "onclick='javascript:return setFocus(this.id)' href='javascript:void(0)'>" + linkText + "</a>" + eapp.webforms.locale.colon + " "
			+ message.trim().replace("<div>","<p>").replace("</div>","</p>").replace("</p><p>","<br /><br />").replace("</p>","").replace("<p>","")
			+ "</span></li>";
	$errorsList.append(message);

}

function isDateField(field) {
	if (field)
		return (field.toLowerCase().indexOf("date") >= 0);
	else
		return false;
}

function hasClass(control, className) {
	var len = control.classList.length;
	for (var ii = 0; ii < len; ii++) {
		if (control.classList[ii] === className) {
			return true;
		}
	}
	return false;
}

function findFailingFormControl(field, panelControls) {
	var nextAction = getElement("#nextAction").val();
	var isAppendSaveRow = nextAction.indexOf("_append_") > 0;

	if (panelControls) {
		var lnt = panelControls.length;
		for (var i = 0; i < lnt; i++) {
			var control = panelControls[i];
			if (!isAppendSaveRow && field.rowNumber != -1
					&& !hasClass(control, "grid-control"))
				continue;
			if (control.id === field.fieldId
					|| (control.name != "" && control.name === field.fullFieldName)
					|| (control.name != "" && control.name === field.fullFieldNameWithUniqueId)) {
				return getElement("#" + control.id);
			}

		}
	}

	return null;
}

function addReadOnlyAttribute(panelControls) {
	if (panelControls) {
		var lnt = panelControls.length;
		for (var i = 0; i < lnt; i++) {
			var el = panelControls[i];
			if (!hasClass(el, "btn-next") && !hasClass(el, "btn-previous")
					&& el.getAttribute("title") != "Modify") {
				el.setAttribute("readonly", true);
				el.setAttribute("disabled", true);
			}
			// change labels viewAndExit
			if (el.getAttribute("title") === "Modify") {

			}
		}
	}
	// btn btn-primary
}

function removeFixedErrors(errors) {

	if (errors === null || errors.length === 0) {
		hideValidationErrorsDiv();
	}
	removeLabelErrors(errors);
	removeQuestionDescriptionErrors(errors);
	removeTableDescriptionErrors(errors);
	removeGridControlErrors(errors);

	eappAddIcons();
	updateErrorAttributesFields("question-label");
	updateErrorAttributesFields("question-description");

	// hide validation errors div
	if ($(".question-label-error").length === 0
			&& $(".question-description-error").length === 0
			&& $(".table-description-error").length === 0
			&& $(".grid-control-error").length === 0) {
		hideValidationErrorsDiv();
	}

}

function removeLabelErrors(errors) {
	var $labelErrors = $(".question-label-error"), len = $labelErrors.length;

	for (var i = 0; i < len; i++) {
		var fieldId = $labelErrors[i].getAttribute("for");
		if (fieldId != null) {
			if (isFieldFixed(errors, fieldId)) {
				removeErrorMessages(fieldId, "question-label");
			}
		}
	}
}

function removeQuestionDescriptionErrors(errors) {
	var $descriptionErrors = $(".question-description-error"), len = $descriptionErrors.length;

	for (var i = 0; i < len; i++) {
		var fieldId = $descriptionErrors[i].id;
		if (fieldId.length !== 0
				&& fieldId.substr(0, 21) === "question-description-") {
			fieldId = fieldId.substr(21);
			if (isFieldFixed(errors, fieldId)) {
				removeErrorMessages(fieldId, "question-description");
			}
		}
	}
}

function removeTableDescriptionErrors(errors) {
	var $tableDescriptionErrors = $(".table-description-error"), len = $tableDescriptionErrors.length;

	for (var i = 0; i < len; i++) {
		var fieldId = $tableDescriptionErrors[i].id;
		if (fieldId.length !== 0
				&& fieldId.substr(0, 18) === "table-description-") {
			fieldId = fieldId.substr(18);
			if (isFieldFixed(errors, fieldId)) {
				removeErrorMessages(fieldId, "table-description");
			}
		}
	}
}

function removeGridControlErrors(errors) {
	var $gridControlErrors = $(".grid-control-error"), len = $gridControlErrors.length;

	for (var i = 0; i < len; i++) {
		var fieldId = $gridControlErrors[i].id;
		var arr = fieldId.split("_");
		var arrLength = arr.length;
		var href = arr[arrLength - 2] + "_" + arr[arrLength - 1];
		if (isFieldFixed(errors, href)) {
			removeErrorMessages(fieldId, "grid-control");
		}
	}
}

function enable() {
	// enable all panels
	var i, $accordionHeaders = $(".ui-accordion-header"), len = $accordionHeaders.length;
	for (i = 0; i < len; i++) {
		getElement("#ui-accordion-accordion-header-" + i).removeClass(
				"ui-state-disabled");
	}
	enableSaveAndExit();
}

function removeErrorMessages(fieldId, questionClass) {
	var field = getFieldLabelOrDescriptionForFieldId(fieldId, questionClass);
	if (field != null) {
		removeErrorClass(field, questionClass);
		removeErrorIndicatorImage(field, questionClass);
		removeErrorMessageLink(fieldId, questionClass);
	}

}

function removeErrorIndicatorImage(field, questionClass) {

	var $el = field;

	if ($el.length) {

		if (questionClass === "grid-control")
			$el = $("#table-description-" + $el.attr("data-tableDescription"));

		if (questionClass === "question-label"
				|| questionClass === "question-description") {
			$el.children(".question-error-indicator").remove();
			$el.children(".question-error-indicator-text").remove();
		} else if (questionClass === "grid-control"
				|| questionClass === "table-description") {
			$el.children(".table-error-indicator").remove();
			$el.children(".table-error-indicator-text").remove();
		}
	}

}

function removeErrorClass(field, questionClass) {

	if (field.length) {
		field.removeClass(questionClass + "-error").addClass(questionClass);
	}

}

function removeErrorMessageLink(fieldId, questionClass) {
	var el, $el;
	if (questionClass === "question-label") {
		el = "a[href='#" + fieldId + "']";
	} else if (questionClass === "question-description") {

		el = "a[href='#question-description-" + fieldId + "']";

	} else if (questionClass === "table-description") {
		el = "a[href='#table-description-" + fieldId + "']";
	} else if (questionClass === "grid-control") {
		// applicantFirstName_1-error
		var arr = fieldId.split("_");
		var fieldIdWithoutPath = fieldId;
		if (arr.length > 1) {
			fieldIdWithoutPath = arr[arr.length - 2] + "_"
					+ arr[arr.length - 1];
		}
		el = "a[id='" + fieldIdWithoutPath + "-error']";

	}
	$el = $(el);
	if ($el.length) {
		$el.closest("li").remove();
	}

}

function isFieldFixed(errors, fieldId) {

	if (errors === null)
		return true;

	var $errorCode, len = errors.length;

	if (fieldId.toLowerCase().indexOf("date") >= 0) {
		$errorLink = $("#" + fieldId + "-year" + "-error");
	} else {
		$errorLink = $("#" + fieldId + "-error");
	}

	if ($errorLink) {
		$errorCode = $errorLink.attr("data-errorCode");
	}

	for (var i = 0; i < len; i++) {

		// leave it, there error was not fixed
		if (fieldId === errors[i].field.split("_")[0]
				&& errors[i].code === $errorCode)
			return false;
	}
	return true;
}

function showHTML(responseObject, outputDivId) {
	if (responseObject.html != null) {
		
		getElement("#" + outputDivId).html(responseObject.html);
	}

	// update the UI if required with the model.
	if ((typeof updateUI !== "undefined") && jQuery.isFunction(updateUI)) {

		config = {
			templateName : outputDivId
		};

		updateUI(responseObject.webForm, config);
	}
}

function showNext(outputDivId, selectedElementId, templateMap, completionCallback) {

	// if selectedValue in templateMap, grab it's template
	var selectedElement = getElement("#" + selectedElementId);
	if (selectedElement && selectedElement.length > 0) {
		var selectedCodeValue;

		if (getElementType(selectedElement) == 'checkbox') {
			selectedCodeValue = isSelectionElementChecked(selectedElement);
		} else {
			selectedCodeValue = selectedElement.val();
		}
		var nextAction;

		if (templateMap) {
			var template = templateMap[selectedCodeValue];
			if (template) {
				nextAction = template;
			} else {
				nextAction = templateMap[eapp.webforms.constants.subscribeToAllOtherValues];
			}
		} else {
			if (eapp.webforms.constants.yesNo.yes == selectedCodeValue) {
				nextAction = outputDivId;
			}
		}

		if (nextAction !== undefined) {
			setNextAction(nextAction);
			showNextQuestions("/eapp/showNext", "accordion", null,
					outputDivId, completionCallback, selectedElement);

		} else {
			clearElement(outputDivId);
		}
	} else {
		clearElement(outputDivId);
	}
}

function clearElement(elementId) {
	setElement(elementId, "");
}

function setElement(elementId, content) {
	getElement("#" + elementId).html(content);
}

function disableValidation() {
	getElement("#validate").val("false");
}

function enableValidation() {
	getElement("#validate").val("true");
}

function setNextAction(value) {
	getElement("#nextAction").val(value);
}

function showLanguages(selectedValue) {
	var yesNo = eapp.webforms.constants.yesNo;
	if (yesNo.yes == selectedValue) {
		setNextAction("languageDisorders");
		getElement("#proofOfLanguage").html("");
		getElement("#consent").html("");
		showNextQuestions();

	} else if (yesNo.no == selectedValue) {
		setNextAction("proofOfLanguage");
		getElement("#languageDisorders").html("");
		showNextQuestions();

	} else {
		getElement("#" + divId).html("");
	}
}

function showNextTab(panelId, divName) {
	// hide the #requiredFieldsStatus div on previous and next button press
	hideRequiredFieldsStatusDiv();

	if ($(".help-helptip-content").length > 0
			|| $(".glossary-helptip-content").length > 0) {

		if (typeof theHelptip !== 'undefined' && theHelptip.initialized) {
			theHelptip.remove();
		}

	}
	showNextQuestions("/eapp/showNext", divName, panelId);
}

function getAllFormControls(divName) {
	if (!divName)
		return null;

	return getElement("#" + divName + " .form-control, #" + divName
			+ " .question-checkbox");
}
function getAllButtons(divName) {
	return getElement("#" + divName + " .btn");
}
function addPanelCompletionStatus(webFormStatus) {
	// find all accordion panels
	// get controls for each panel

	var divs = $(".ui-accordion-content");
	$(divs).each(function(index) {
		var divControls = getAllFormControls(this.id);
		// commented out
		var errorsFlags = findErrors(divControls);
		addCompletionStatus(webFormStatus, errorsFlags, index);
		makeDivContentReadOnly(divControls, this.id);

	});
}

function findErrors(panelControls) {

	var errorsFlags = {};
	errorsFlags.nonMandatoryErrors = false;
	errorsFlags.mandatoryErrors = false;
	var errors = eapp.webforms.errors;
	if (errors && errors.length > 0) {
		for (var a = 0; a < errors.length; a++) {
			var field = new Field(errors[a]);
			if (findFailingFormControl(field, panelControls) === null)
				continue;

			if ((errors[a].codes[0] === 'error.MandatoryFields')) {
				errorsFlags.mandatoryErrors = true;
				// do not display mandatory errors
				continue;
			}
			errorsFlags.nonMandatoryErrors = true;
		}
	}
	return errorsFlags;
}

function initGridHeadings(id, tableCaption) {

	var j, el = document.getElementById(id), theads = el
			.getElementsByTagName('thead');

	if (!theads[0])
		return;

	var tds = theads[0].getElementsByTagName('td'), row = document
			.createElement('tr'), len = tds.length, jlast = len - 1;

	for (j = 0; j < len; j += 1) {
		var idTh = tds[j].id, classTh = tds[j].className, th = document
				.createElement('th');

		th.setAttribute('scope', 'col');

		if (idTh != null)
			th.id = idTh;
		if (classTh != null)
			th.className = classTh;
		if (j === jlast) {
			th
					.appendChild(document
							.createTextNode(eapp.webforms.locale.action));
		} else {
			var s = charEntitiesToUnicode(tds[j].innerHTML);
			th.appendChild(document.createTextNode(s));
		}
		row.appendChild(th);
	}

	while (theads[0].firstChild) {
		theads[0].removeChild(theads[0].firstChild);
	}

	theads[0].appendChild(row);

	// add table caption
	var caption = document.createElement('caption');
	caption.appendChild(document.createTextNode(tableCaption));
	theads[0].parentNode.insertBefore(caption, theads[0]);

	return;
}

function submitWebForm(divId) {
	
	disableSaveAndExit();
	setNextAction(divId);
	showNextQuestions("/eapp/submitWebForm");
}

function getElement(selector) {
	return $(selector);
}

function configureAccordions() {
	$("#accordion").accordion({
		heightStyle : "content",
		header : ".eapp-accordion-header",
		create : function(event, ui) {
			$(".ui-accordion-content").addClass("eapp-accordion-panel");
		},
		activate : function(event, ui) {
		}
	});

	$("#accordion").on(
			"accordionactivate",
			function(event, ui) {
				$(window).scrollTop(ui.newHeader.offset().top);
				webFormAccessibility.focusOnFirstTabbableElement("",
						ui.newPanel.attr("id"));
			});
}

function activePanel() {
	var n = nAccordionPanels(".eapp-accordion-panel");
	return (n < 0) ? n : $("#accordion").accordion("option", "active");
}

function nAccordionPanels(selector) {
	var accordionPanels = $(selector);
	return accordionPanels.length - 1;
}

function initializeWebFormUI(webFormId, section) {
	configureAccordions();
	// call up any init' method if we have one available.
	if ((typeof initializeUI !== "undefined")
			&& jQuery.isFunction(initializeUI)) {
		initializeUI(webFormId, section);
	}
}

function isWebformQuestionEvent(event) {
	// get the event target and make sure it is a question (input field,
	// checkbox, select, etc...)
	if (event.target.className.indexOf('question-checkbox') > -1
			|| event.target.className.indexOf('form-control') > -1)
		return true;
	else
		return false;
}

function detectIE() {
	var ua = window.navigator.userAgent;
	var msie = ua.indexOf('MSIE ');
	var trident = ua.indexOf('Trident/');

	if (msie > 0) {
		// IE 10 or older => return version number
		return parseInt(ua.substring(msie + 5, ua.indexOf('.', msie)), 10);
	}

	if (trident > 0) {
		// IE 11 (or newer) => return version number
		var rv = ua.indexOf('rv:');
		return parseInt(ua.substring(rv + 3, ua.indexOf('.', rv)), 10);
	}

	// other browser
	return false;
}

function initializeConsoleIfRequired() {
	var method;
	var noop = function() {
	};
	var methods = [ 'assert', 'clear', 'count', 'debug', 'dir', 'dirxml',
			'error', 'exception', 'group', 'groupCollapsed', 'groupEnd',
			'info', 'log', 'markTimeline', 'profile', 'profileEnd', 'table',
			'time', 'timeEnd', 'timeStamp', 'trace', 'warn' ];
	var length = methods.length;
	var console = (window.console = window.console || noop);

	while (length--) {
		method = methods[length];

		// Only stub undefined methods.
		if (!console[method]) {
			console[method] = noop;
		}
	}
}

function hookAjaxRequests() {

	$(document).ajaxStart(onAjaxRequestsStart)
			.ajaxStop(onAjaxRequestsCompleted).ajaxError(onAjaxRequestsError);

	$.ajaxSetup({
		statusCode : {
			401 : function(err) {
				if (console)
					console.warn('Login Failed.', err.responseJSON);
			}
		}
	});
}

function onAjaxRequestsError(event, jqxhr, settings, thrownError) {
	if (console)
		console.warn("Communication error: " + settings.url + " ["
				+ thrownError + "]");
}

function onAjaxRequestsStart() {
	var overlay = eapp.webforms.overlay;
	overlay.requestsDone = false;
	overlay.startTime = Date.now();
	overlay.showTime = undefined;
	overlay.timeoutId = setTimeout(function() {
		// only show overlay if we've not completed before timeout occured.
		if (!overlay.requestsDone) {
			overlay.showTime = Date.now();
			overlay.timeoutId = undefined;
			showOverlay();
		}

	}, (eapp.webforms.overlay.duration / 3));
}

function onAjaxRequestsCompleted() {
	var overlay = eapp.webforms.overlay;
	if (overlay.timeoutId || overlay.showTime) {
		if (overlay.showTime) {
			var endTime = Date.now();
			var exposed = endTime - overlay.showTime;
			// if we've only shown the overlay for less than 1 second; show
			// it for a full second before removing it (including the
			// elapsed time)
			if (exposed < overlay.duration) {
				setTimeout(function() {
					hideOverlay();
				}, overlay.duration - exposed);
			} else {
				// we've shown the overlay for more than 1 second - remove
				// it.
				hideOverlay();
			}
		} else {
			// we've queued for a showOverlay in the 500ms window; but
			// haven't shown it
			// yet and we've completed all requests - therefore cancel
			// queuing....
			hideOverlay();
		}
	} else {
		// request(s) have taken less than half a second to process; so no
		// overlay to show; but cancel any pending showOverlay for good
		// measure.
		overlay.requestsDone = true;
		hideOverlay();
	}
}

function hookAjaxPreFilter() {
	$.ajaxPrefilter("json", function(options, originalOptions, jqXHR) {

		var url = options.url;
		var hasParams = url.indexOf("?") > 0;
		var addLangParam = true;
		if (hasParams) {
			if (url.indexOf("lang=") > 0) {
				addLangParam = false;
			}
		}

		if (addLangParam) {
			if (hasParams) {
				url += "&";
			} else {
				url += "?";
			}

			url += "lang=" + eapp.webforms.locale.localeLanguage;
			options.url = url;
		}

		return options.dataType;
	});
}

function initializeNodeConstants() {
	// create the nodeType constants if the Node object is not defined
	if (!window.Node) {
		var Node = {
			ELEMENT_NODE : 1,
			ATTRIBUTE_NODE : 2,
			TEXT_NODE : 3,
			CDATA_SECTION_NODE : 4,
			ENTITY_REFERENCE_NODE : 5,
			ENTITY_NODE : 6,
			PROCESSING_INSTRUCTION_NODE : 7,
			COMMENT_NODE : 8,
			DOCUMENT_NODE : 9,
			DOCUMENT_TYPE_NODE : 10,
			DOCUMENT_FRAGMENT_NODE : 11,
			NOTATION_NODE : 12
		};
	}
}

function initializeWebForm(webFormId, section) {

	if (!detectIE()) {
		hookAjaxRequests();
	}

	hookAjaxPreFilter();

	// Avoid *console* errors in browsers that lack a console.
	initializeConsoleIfRequired();

	// Avoid *node* errors in browsers that lack a Node type definition....
	initializeNodeConstants();

	initializeWebFormUI(webFormId, section);
	loadData(webFormId, section);
}

function getPropertyNames(o) {

	if (typeof o !== 'object' || o === null) {
		return [];
	}

	if (Object.keys) {
		return Object.keys(o);
	} else {

		// For IE < 9
		var k = [], p;
		for (p in o) {
			if (Object.prototype.hasOwnProperty.call(o, p)) {
				k.push(p);
			}
		}
		return k;
	}
}

function copyElementValueTo(sourceId, destinationId) {
	if (sourceId && destinationId && sourceId.length > 0
			&& destinationId.length > 0) {
		var sourceEl = getElement("#" + sourceId), destinationEl = getElement("#"
				+ destinationId);

		if (sourceEl && destinationEl)
			destinationEl.val(sourceEl.val());
	}
}

function checkFieldCompletion() {
	setNextAction("checkFieldCompletion");
	var dataObj = getData();
	var jsonData = JSON.stringify(dataObj);

	$
			.ajax({
				url : "/eapp/checkFieldCompletion",
				data : jsonData,
				type : "POST",
				dataType : "json",

				beforeSend : function(xhr) {
					xhr.setRequestHeader("Accept", "application/json");
					xhr.setRequestHeader("Content-Type", "application/json");
				},

				// code to run if the request succeeds;
				// the response is passed to the function
				success : function(responseObject) {

					if (responseObject.errors !== null) {
						removeFixedErrors(responseObject.errors);

						// there are no validation errors returned
						if (responseObject.errors.length === 0) {
							// hide the validation error section and remove any
							// fixed errors
							hideValidationErrorsDiv();

							// add the"All required fields are complete" message
							// to #requiredFieldsStatus div
							showRequiredFieldsStatusDiv(eapp.webforms.validation.formComplete);
						} else {
							// Bug 333519 - Error list does not refresh
							// added the below clear of previous errors from the list  
							var $errorsList = getElement("#form-error-list");
							$errorsList.empty();
							
							// the third paramater is a flag to indicate that
							// the checkFieldCompletion button was clicked
							var errorsFlags = addErrors("accordion", responseObject.errors, true);

							// there are validation/ incompletion errors, so
							// hide the "All required fields are complete"
							// message by removing the div
							hideRequiredFieldsStatusDiv();
						}
					}
				}
			});
}

// hides #requiredFieldsStatus
function hideRequiredFieldsStatusDiv() {
	var $requiredFieldsStatus = getElement("#requiredFieldsStatus");
	$requiredFieldsStatus.fadeOut("slow");
}

// shows #requiredFieldsStatus with the message in the passed paramater
function showRequiredFieldsStatusDiv(message) {
	var $requiredFieldsStatus = getElement("#requiredFieldsStatus");
	$requiredFieldsStatus.html(message).prepend(
			"<i class='icon icon-complete' aria-hidden='true'></i>");
	$requiredFieldsStatus.fadeIn();
}

function hideValidationErrorsDiv() {
	var $validationErrors = getElement("#validationErrors");
	$validationErrors.fadeOut("slow");
}

function showValidationErrorsDiv() {
	var $validationErrors = getElement("#validationErrors");
	$validationErrors.fadeIn();
}

(function($) {
	$
			.widget(
					"custom.combobox",
					{
						_create : function() {
							this.wrapper = $("<span>").addClass(
									"eapp-custom-combobox").insertBefore(
									this.element);

							// this.element.hide();
							this._createAutocomplete();
							this._createShowAllButton();
						},

						_createAutocomplete : function() {
							var selected = this.element.children(":selected"), value = selected
									.val() ? selected.text() : "";
							value = $.trim(value);
							// console.log('Value=[' + value + ']');

							this.input = $("<input>")
									.appendTo(this.wrapper)
									.val(value)
									.attr("title", "")
									.attr("role", "combobox")
									.addClass(
											"form-control eapp-custom-combobox-input ui-widget ui-widget-content ui-state-default ui-corner-left")
									.attr(
											"aria-labelledby",
											"question-label-"
													+ this.wrapper
															.parent("div")
															.find("select")
															.attr("id")).attr(
											"aria-autocomplete", "inline")
									.autocomplete({
										delay : 0,
										minLength : 0,
										source : $.proxy(this, "_source")
									});

							this.input.autocomplete({
								messages : {
									noResults : eapp.webforms.locale.noResults,
									results : function() {
										return eapp.webforms.locale.foundMatch;
									}
								}
							});

							this._on(this.input, {
								autocompleteselect : function(event, ui) {
									ui.item.option.selected = true;
									this._trigger("select", event, {
										item : ui.item.option
									});
								},

								autocompletechange : "_removeIfInvalid"
							});
						},

						_createShowAllButton : function() {
							var input = this.input, wasOpen = false;

							$("<button>")
									.attr("tabIndex", 0)
									.attr("title",
											eapp.webforms.locale.showAllItems)
									.appendTo(this.wrapper)
									.addClass(
											"btn btn-default eapp-custom-combobox-toggle")
									.attr("aria-labelledby",
											"eapp-search-label")
									.attr("aria-controls", "eapp-list")
									.append(
											"<i class='icon icon-search'></i><span id='eapp-search-label'>"
													+ eapp.webforms.locale.search
													+ "</span>").mousedown(
											function() {
												wasOpen = input.autocomplete(
														"widget")
														.is(":visible");
											}).click(function() {
										input.focus();

										// Close if already visible
										if (wasOpen) {
											return;
										}

										// Pass empty string as value to search
										// for, displaying all results
										input.autocomplete("search", "");
									});
						},

						_source : function(request, response) {
							var matcher = new RegExp($.ui.autocomplete
									.escapeRegex(request.term), "i");
							response(this.element.children("option").map(
									function() {
										var text = $(this).text();
										text = $.trim(text);
										if (this.value
												&& (!request.term || matcher
														.test(text)))
											return {
												label : text,
												value : text,
												option : this
											};
									}));
						},

						_removeIfInvalid : function(event, ui) {

							// Selected an item; return
							if (ui.item) {
								return;
							}

							// Search for a match (case-insensitive)
							console.log('Search for a match');

							var value = this.input.val(), valueLowerCase = value
									.toLowerCase(), valid = false;
							this.element
									.children("option")
									.each(
											function() {
												if ($(this).text()
														.toLowerCase().indexOf(
																valueLowerCase) !== -1) {
													this.selected = valid = true;
													return false;
												}

											});

							// Found a match; return
							if (valid) {
								this.input.attr("title",
										eapp.webforms.locale.foundMatch)
								return;
							}

							// Remove invalid value
							this.input.val("").attr("title",
									eapp.webforms.locale.didNotMatchItem);

							this.element.val("");
							this._delay(function() {
								// this.input.tooltip("close").attr( "title", ""
								// );
							}, 2500);
							this.input.val("");
						},

						_destroy : function() {
							this.wrapper.remove();
							this.element.show();
						}
					});
})(jQuery);

$(function() {
	$("#nocLevel").combobox();
	
	$("#nocLevel").ready(function() {
		$(".eapp-custom-combobox-input").val("");
	});
	
	$(".eapp-custom-combobox-input").on("click", function () {
		$(".eapp-custom-combobox-input").val("");
	});
	
	$('#nocLevel').on('change', function() {
		$(".eapp-custom-combobox-input").val("");
	});

	$("#toggle").click(function() {
		$("#nocLevel").toggle();
	});
});
